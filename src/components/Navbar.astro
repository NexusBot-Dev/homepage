---
import { Image } from 'astro:assets';
import logoImg from '../assets/logo.png';

import Button from './Button.astro';
import { NAV_LINKS, BRAND_NAME, BRAND_LOGO_TEXT } from '../config';
import { resolvePath } from '../utils/navigation';
---

<header class="sticky top-0 z-[90] w-full transition-colors duration-300 glass-panel border-x-0 border-t-0 rounded-none shadow-sm pointer-events-auto">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center transition-transform group-hover:scale-105 overflow-hidden">
            <Image
              src={logoImg}
              alt={`${BRAND_NAME} Logo`}
              width={32}
              height={32}
              class="rounded-xl object-contain"
            />
          </div>
          <span class="font-heading font-bold text-xl text-slate-900 dark:text-white">{BRAND_NAME}</span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-8">
        {NAV_LINKS.map(link => (
          <a href={resolvePath(link.href)} class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA Button (Desktop) -->
      <div class="hidden md:flex items-center gap-4">
        <!-- Login Button -->
        <Button href={resolvePath('https://dashboard.trynexus.de/')} variant="primary" size="sm">Zum Dashboard</Button>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center gap-2">
        <button onclick="window.toggleCommandPalette()" class="p-2 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none rounded-lg text-sm" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
        </button>

        <button id="mobile-menu-btn" class="p-2 rounded-md text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none">
          <span class="sr-only">Open main menu</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
      {NAV_LINKS.map(link => (
        <a href={resolvePath(link.href)} class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 dark:text-slate-300 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-slate-50 dark:hover:bg-slate-800">
          {link.label}
        </a>
      ))}
      <div class="mt-4 pt-4 border-t border-slate-200 dark:border-slate-800 flex flex-col gap-2">
        <Button href={resolvePath('https://dashboard.trynexus.de/')} variant="primary" size="sm">Zum Dashboard</Button>
      </div>
    </div>
  </div>
</header>

<script>
  function setupTheme() {
    const storedTheme = localStorage.getItem('theme');
    if (storedTheme === 'dark' || storedTheme === 'light') {
      document.documentElement.classList.toggle('dark', storedTheme === 'dark');
    }

    function updateIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        button.setAttribute('aria-pressed', String(isDark));
        button.querySelector('[data-theme-dark-icon]')?.classList.toggle('hidden', isDark);
        button.querySelector('[data-theme-light-icon]')?.classList.toggle('hidden', !isDark);
      });
    }

    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateIcons();
    }

    updateIcons();

    document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
      if (button.dataset.themeBound === 'true') return;
      button.dataset.themeBound = 'true';
      button.addEventListener('click', toggleTheme);
    });
  }

  function setupMobileMenu() {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    if (mobileMenuBtn && mobileMenu) {
      // Use a fresh button to avoid multiple listeners
      const newBtn = mobileMenuBtn.cloneNode(true);
      mobileMenuBtn.parentNode?.replaceChild(newBtn, mobileMenuBtn);

      newBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
  }

  // Run on initial load
  setupTheme();
  setupMobileMenu();

  // Run on View Transitions page changes
  document.addEventListener('astro:page-load', () => {
    setupTheme();
    setupMobileMenu();
  });
</script>
