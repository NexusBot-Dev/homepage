---
import { badgeConfig, formatDate, groupByMonth, parseBadges } from '../lib/changelog';

interface Props {
  releases: any[];
  lang: string;
  // Neuesten Release aufgeklappt anzeigen
  openFirst?: boolean;
}

const { releases, lang, openFirst = false } = Astro.props;
const groups = groupByMonth(releases, lang);
const firstId = releases[0]?.id;
---

<div class="space-y-12">
  {groups.map((group) => (
    <section>
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-4">
        {group.label}
      </h2>
      <div class="space-y-4">
        {group.releases.map((item: any) => (
          <details
            class="group bg-slate-900/60 border border-slate-800/80 hover:border-slate-700/80 rounded-2xl backdrop-blur-sm transition-colors shadow-sm"
            open={openFirst && item.id === firstId}
          >
            <!-- Kopfzeile: immer sichtbar, Klick klappt auf -->
            <summary class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 p-6 md:px-8 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <div class="flex flex-col gap-3 min-w-0">
                <div class="flex flex-wrap items-center gap-2.5">
                  <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    {item.version}
                  </span>
                  {parseBadges(item.badge).map((bKey: string) => {
                    const conf = badgeConfig[bKey.toLowerCase()] || {
                      label: bKey,
                      class: "bg-slate-800 text-slate-300 border-slate-700"
                    };
                    return (
                      <span class={`px-2.5 py-0.5 rounded-full text-xs font-semibold border ${conf.class}`}>
                        {conf.label}
                      </span>
                    );
                  })}
                </div>
                {item.title && (
                  <h3 class="text-lg md:text-xl font-bold text-white">
                    {item.title}
                  </h3>
                )}
              </div>

              <div class="flex items-center gap-3 shrink-0">
                {item.release_date && (
                  <time class="text-xs font-medium text-slate-400">
                    {formatDate(item.release_date, lang)}
                  </time>
                )}
                <svg class="w-4 h-4 text-slate-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
              </div>
            </summary>

            <!-- WYSIWYG Content aus Directus -->
            <div class="px-6 md:px-8 pb-6 md:pb-8 pt-6 border-t border-slate-800/80 prose prose-invert max-w-none
              prose-h3:text-base prose-h3:font-semibold prose-h3:text-slate-200 prose-h3:mt-6 prose-h3:mb-2
              prose-p:text-slate-300 prose-p:leading-relaxed
              prose-ul:my-2 prose-li:text-slate-300 prose-li:my-1">
              <Fragment set:html={item.content} />
            </div>
          </details>
        ))}
      </div>
    </section>
  ))}
</div>
