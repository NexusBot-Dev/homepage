---
import { DISCORD_INVITE_URL } from '../config';
import { resolvePath } from '../utils/navigation';
import { useTranslations } from '../i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Fallback-Icon, falls mal ein Feature dazukommt, bevor jemand ein eigenes
// Icon dafür in iconsByGroup ergänzt hat.
const iconFallback = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>`;

const iconsByGroup: string[][] = [
  [
    // Moderation & Sicherheit
    `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6l7-3z"/></svg>`,
    `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16l-6 8v6l-4 2v-8L4 4z"/></svg>`,
    `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6l7-3z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`,
  ],
  [
    // Community & Aktivität
    `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="14 7 21 7 21 14"/></svg>`,
    `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>`,
    `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>`,
    `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  ],
  [
    // Inhalte & Automatisierung
    `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/></svg>`,
    `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 15"/></svg>`,
    `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M4.9 4.9a10 10 0 0 0 0 14.1"/><path d="M19.1 4.9a10 10 0 0 1 0 14.1"/></svg>`,
  ],
  [
    // Support & Verwaltung
    `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2 2 0 0 0 0-4V8z"/><line x1="13" y1="6" x2="13" y2="18" stroke-dasharray="2 2"/></svg>`,
    `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>`,
    `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>`,
  ],
];

const wikiHrefsByGroup: (string | undefined)[][] = [
  [`/${lang}/wiki/dokumentation/moderation/`, `/${lang}/wiki/dokumentation/automod/`, undefined],
  [`/${lang}/wiki/dokumentation/leveling/`, undefined, `/${lang}/wiki/dokumentation/welcome/`, undefined],
  [undefined, undefined, `/${lang}/wiki/dokumentation/stream-alerts/`],
  [undefined, undefined, undefined],
];

const tagStyles: Record<string, string> = {
  free: 'bg-primary-100 dark:bg-primary-900/30 text-primary-800 dark:text-primary-300 border-primary-200 dark:border-primary-800',
  premium: 'bg-purple-100 dark:bg-purple-900/30 text-purple-800 dark:text-purple-300 border-purple-200 dark:border-purple-800',
  soon: 'bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-300 border-amber-200 dark:border-amber-800',
};

const tagLabels: Record<string, string> = {
  free: t.featureList.tagFree,
  premium: t.featureList.tagPremium,
  soon: t.featureList.tagSoon,
};
---

<section class="py-24 md:py-32">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
    <div class="text-center max-w-3xl mx-auto mb-16 reveal-on-scroll">
      <h1 class="text-4xl md:text-5xl font-heading font-extrabold text-slate-900 dark:text-white mb-6">
        {t.featureList.pageTitle} <span class="text-primary-500">{t.featureList.pageTitleHighlight}</span>
      </h1>
      <p class="text-xl text-slate-600 dark:text-slate-400">
        {t.featureList.pageSubtitle}
      </p>
    </div>

    <div class="space-y-16">
      {t.featureList.groups.map((group, groupIndex) => (
        <div class="reveal-on-scroll">
          <h2 class="text-sm font-bold font-heading uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-6">
            {group.category}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {group.features.map((feature, featureIndex) => {
              const wikiHref = wikiHrefsByGroup[groupIndex]?.[featureIndex];
              const icon = iconsByGroup[groupIndex]?.[featureIndex] ?? iconFallback;
              return (
                <div class="glass-panel rounded-2xl p-6 flex flex-col hover-glow">
                  <div class="flex items-start justify-between gap-3 mb-3">
                    <div class="w-10 h-10 shrink-0 bg-primary-100 dark:bg-primary-900/40 text-primary-600 dark:text-primary-400 rounded-xl flex items-center justify-center" set:html={icon} />
                    {feature.tag && (
                      <span class={`text-[10px] font-bold px-2.5 py-1 rounded-full border uppercase tracking-wide whitespace-nowrap ${tagStyles[feature.tag]}`}>
                        {tagLabels[feature.tag]}
                      </span>
                    )}
                  </div>
                  <h3 class="text-lg font-heading font-bold text-slate-900 dark:text-white mb-2">{feature.title}</h3>
                  <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed flex-grow">{feature.description}</p>
                  {wikiHref && (
                    <a
                      href={resolvePath(wikiHref)}
                      class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors"
                    >
                      {t.featureList.wikiLinkLabel}
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                    </a>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-20 reveal-on-scroll">
      <a
        href={DISCORD_INVITE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 text-lg bg-primary-500 hover:bg-primary-600 text-slate-950 font-bold px-8 py-4 rounded-xl transition-all duration-200 transform hover:-translate-y-0.5 shadow-lg shadow-primary-500/20"
      >
        {t.featureList.inviteButton}
      </a>
    </div>
  </div>
</section>