---
import { DISCORD_SUPPORT_SERVER } from '../config';
import { useTranslations } from '../i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Icon/Farbe sind rein dekorativ und bleiben Index-gebunden an t.roadmap.items
const STATUS = {
  released: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
  inProgress: 'bg-amber-500/10 text-amber-400 border-amber-500/20',
  planned: 'bg-sky-500/10 text-sky-400 border-sky-500/20',
};
const visuals = [
  {
    // AutoMod 2.0
    statusColor: STATUS.inProgress,
    iconColor: 'text-amber-400 bg-amber-500/10 border-amber-500/20',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>`,
  },
  {
    // Embed-Builder
    statusColor: STATUS.planned,
    iconColor: 'text-violet-400 bg-violet-500/10 border-violet-500/20',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-template"><rect width="18" height="7" x="3" y="3" rx="1"/><rect width="9" height="7" x="3" y="14" rx="1"/><rect width="5" height="7" x="16" y="14" rx="1"/></svg>`,
  },
  {
    // Eigene Log-Kanäle & Farben (Premium)
    statusColor: STATUS.planned,
    iconColor: 'text-sky-400 bg-sky-500/10 border-sky-500/20',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-scroll-text"><path d="M15 12h-5"/><path d="M15 8h-5"/><path d="M19 17V5a2 2 0 0 0-2-2H4"/><path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3"/></svg>`,
  },
];

const roadmapItems = t.roadmap.items.map((item, i) => ({ ...item, ...visuals[i] }));
---

<section id="roadmap" class="py-32 border-t border-slate-800 relative">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <div class="text-center max-w-3xl mx-auto mb-16 reveal-on-scroll">
      <h2 class="text-4xl md:text-5xl font-heading font-extrabold text-white mb-6">
        {t.roadmap.heading} <span class="text-primary-500">{t.roadmap.headingBrand}</span> Roadmap
      </h2>
      <p class="text-xl text-slate-400">
        {t.roadmap.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto mb-16">
      {roadmapItems.map((item) => (
        <div class="glass-panel hover-glow rounded-3xl p-8 flex flex-col justify-between relative overflow-hidden reveal-on-scroll">
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class={`w-12 h-12 border rounded-2xl flex items-center justify-center ${item.iconColor}`} set:html={item.icon} />
              
              <span class={`text-xs font-semibold px-3 py-1 rounded-full border ${item.statusColor}`}>
                {item.status}
              </span>
            </div>

            <h3 class="text-xl font-bold text-white mb-3">{item.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed">{item.description}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-12 reveal-on-scroll">
      <p class="text-slate-500 text-sm mb-4">{t.roadmap.ideaPrompt}</p>
      <a 
        href={DISCORD_SUPPORT_SERVER} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-2 bg-primary-500 hover:bg-primary-600 text-slate-950 font-bold px-6 py-3 rounded-2xl transition-all duration-200 transform hover:-translate-y-0.5 shadow-lg shadow-primary-500/20"
      >
        {t.roadmap.ideaButton}
      </a>
    </div>
  </div>
</section>
