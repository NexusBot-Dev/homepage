---
import { Image } from 'astro:assets';
import logoImg from '../assets/logo.png';

import { FOOTER_LINKS, BRAND_NAME, BRAND_LOGO_TEXT, SITE_DESCRIPTION } from '../config';
import { resolvePath } from '../utils/navigation';
---

<footer class="bg-white dark:bg-[#09090b] border-t border-slate-200 dark:border-slate-800 pt-16 pb-8 transition-colors">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-[minmax(280px,1.35fr)_repeat(3,minmax(140px,1fr))] lg:gap-10 mb-12">
      <!-- Brand -->
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center transition-transform group-hover:scale-105 overflow-hidden">
            <Image
              src={logoImg}
              alt={`${BRAND_NAME} Logo`}
              width={32}
              height={32}
              class="rounded-xl object-contain"
            />
          </div>
          <span class="font-heading font-bold text-xl text-slate-900 dark:text-white">{BRAND_NAME}</span>
        </a>
        <p class="text-slate-600 dark:text-slate-400 text-sm mb-6">
          {SITE_DESCRIPTION}
        </p>
      </div>

      <!-- Links -->
      {FOOTER_LINKS.map(group => (
        <div>
          <h3 class="font-semibold text-slate-900 dark:text-white mb-4">{group.title}</h3>
          <ul class="space-y-3">
            {group.links.map((link: any) => {
              const isExternal = link.external || link.href.startsWith('http://') || link.href.startsWith('https://');
              const finalHref = isExternal ? link.href : resolvePath(link.href);

              return (
                <li>
                  <a
                    href={finalHref}
                    target={isExternal ? '_blank' : undefined}
                    rel={isExternal ? 'noopener noreferrer' : undefined}
                    class="text-sm text-slate-600 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>

    <div class="border-t border-slate-200 dark:border-slate-800 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sm text-slate-500 dark:text-slate-400">
        &copy; {new Date().getFullYear()} {BRAND_NAME}. All rights reserved.
      </p>
    </div>
  </div>
</footer>