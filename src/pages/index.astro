---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Roadmap from '../components/Roadmap.astro';
import Premium from '../components/Premium.astro';
import FAQ from '../components/FAQ.astro';
import { resolvePath } from '../utils/navigation';
import { DISCORD_INVITE_URL, DISCORD_SUPPORT_SERVER } from '../config';
---

<BaseLayout title="Home">
    <Hero />
    <Features />
    <Roadmap />
    <Premium />
    <FAQ />

    <!-- Final CTA Section before footer -->
    <section class="py-32 bg-primary-600 dark:bg-primary-900 text-white text-center relative overflow-hidden">
    <!-- Subtiler Grid-Hintergrundeffekt -->
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCI+CjxyZWN0IHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCIgZmlsbD0ibm9uZSI+PC9yZWN0Pgo8Y2lyY2xlIGN4PSIxIiBjeT0iMSIgcj0iMSIgZmlsbD0icmdiYSgyNTUsMjU1LDI1NSwwLjE1KSI+PC9jaXJjbGU+Cjwvc3ZnPg==')] opacity-50"></div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl relative z-10 reveal-on-scroll">
        <h2 class="text-4xl md:text-6xl font-heading font-extrabold mb-6 tracking-tight">
        Bereit, deinen Server auf das nächste Level zu bringen?
        </h2>
        <p class="text-xl text-primary-100 dark:text-primary-200 mb-12 max-w-2xl mx-auto">
        Verpasse deinem Discord-Server das Upgrade, das er verdient. Hole dir Nexus noch heute und starte direkt durch.
        </p>
        
        <div class="flex flex-col sm:flex-row justify-center gap-4">
        <!-- Haupt-Button: Bot einladen -->
        <a 
            href={DISCORD_INVITE_URL} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center justify-center gap-2 px-8 py-4 text-lg font-bold rounded-xl bg-white text-primary-600 hover:bg-slate-50 hover:scale-105 transition-all shadow-2xl shadow-black/20"
        >
            <!-- Kleines Discord Icon für den optischen Hingucker -->
            <svg class="w-6 h-6 fill-current" viewBox="0 0 127.14 96.36">
            <path d="M107.7,8.07A105.15,105.15,0,0,0,77.26,0a77.19,77.19,0,0,0-3.3,6.83A96.67,96.67,0,0,0,53.22,6.83,77.19,77.19,0,0,0,49.88,0,105.15,105.15,0,0,0,19.44,8.07C3.66,31.58-1.86,54.65,1,77.53A105.73,105.73,0,0,0,32,96.36a74.37,74.37,0,0,0,6.72-11A68.6,68.6,0,0,1,28,80.39c1-.76,2-1.56,3-2.37a75.52,75.52,0,0,0,65.16,0c1,.81,2,1.61,3,2.37a68.52,68.52,0,0,1-10.74,5A74,74,0,0,0,95.11,96.36,105.53,105.53,0,0,0,126.11,77.53C129.5,50.12,122.16,27.14,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53S36.18,40.36,42.45,40.36,53.83,46,53.83,53,48.72,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.24,60,73.24,53S78.41,40.36,84.69,40.36,96.07,46,96.07,53,91,65.69,84.69,65.69Z"/>
            </svg>
            Nexus einladen
        </a>
        
        <!-- Sekundärer Button: Support Server -->
        <a 
            href={DISCORD_SUPPORT_SERVER} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold rounded-xl border-2 border-primary-400 text-white hover:bg-primary-700 dark:hover:bg-primary-800 transition-colors"
        >
            Community & Support
        </a>
        </div>
        </div>
    </section>
</BaseLayout>
