---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { localizedPath } from '../utils/navigation';
import { DEFAULT_LANG, useTranslations } from '../i18n';

Astro.response.status = 404;
Astro.response.statusText = 'Not Found';

const lang = Astro.locals.lang || DEFAULT_LANG;
const t = useTranslations(lang).notFound;
---

<BaseLayout title={t.title} description={t.description} lang={lang}>
  <div class="py-24 md:py-32 flex-grow flex items-center justify-center">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-2xl">
      <div class="text-primary-600 font-bold text-7xl md:text-9xl mb-6">404</div>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">{t.heading}</h1>
      <p class="text-lg text-slate-400 mb-10">
        {t.text}
      </p>
      <div class="flex justify-center gap-4">
        <Button href={localizedPath(lang, '/')} variant="primary" size="lg">{t.homeButton}</Button>
        <Button href={localizedPath(lang, '/wiki/')} variant="outline" size="lg">{t.docsButton}</Button>
      </div>
    </div>
  </div>
</BaseLayout>
