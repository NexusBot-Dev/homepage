---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PricingComponent from '../../components/Premium.astro';
import FAQ from '../../components/FAQ.astro';

const { lang: rawLang } = Astro.params;
const lang = rawLang ?? 'de';
---

<BaseLayout title="Premium" description="Einfache und transparente Preise für Nexus.">
  <div class="pt-16 dark:bg-[#0c0c0f]">
    <PricingComponent lang={lang} />
  </div>

  <FAQ />

</BaseLayout>
