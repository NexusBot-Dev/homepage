---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { directus, readItems } from '../../../../lib/directus';

const { lang: rawLang, category: rawCategory, slug: rawSlug } = Astro.params;
let category = rawCategory;
let slug = rawSlug;
const lang = (rawLang || 'de').toLowerCase();

// Trailing Slashes & Whitespace bereinigen
slug = slug?.replace(/\/$/, '').trim();
category = category?.replace(/\/$/, '').trim();

let categories: any[] = [];
let currentArticle: any = null;
let currentCategory: any = null;

// Hilfsfunktion: Mappt z. B. 'en' -> 'en-US' und 'de' -> 'de-DE'
const getTranslation = (item: any, targetLang: string) => {
  if (!item) return null;
  const translations = Array.isArray(item.translations) ? item.translations : [];

  const matched = translations.find((t: any) => {
    const rawCode = typeof t.languages_code === 'object' && t.languages_code !== null
      ? (t.languages_code.code || t.languages_code.id)
      : t.languages_code;

    const code = String(rawCode || '').toLowerCase();
    const target = targetLang.toLowerCase();

    return code === target || code.startsWith(`${target}-`) || target.startsWith(`${code}-`);
  });

  return {
    ...item,
    title: (matched && matched.title) ? matched.title : item.title || '',
    description: (matched && matched.description) ? matched.description : item.description || '',
    content: (matched && matched.content) ? matched.content : item.content || ''
  };
};

const extractCatId = (catVal: any): string | null => {
  if (!catVal) return null;
  if (Array.isArray(catVal) && catVal.length > 0) {
    const first = catVal[0];
    return String(typeof first === 'object' && first !== null ? (first.id || first.doc_categories_id) : first);
  }
  if (typeof catVal === 'object' && catVal !== null) {
    return String(catVal.id || catVal.doc_categories_id);
  }
  return String(catVal);
};

try {
  // 1. Hole Kategorien und Artikel mit Translation-Objekten
  const [rawCategories, rawArticles] = await Promise.all([
    directus.request(readItems('doc_categories', {
      sort: ['sort'],
      fields: ['*', 'translations.*', 'translations.languages_code.*']
    })),
    directus.request(readItems('doc_articles', {
      filter: { status: { _eq: 'published' } },
      sort: ['sort'],
      fields: ['*', 'translations.*', 'translations.languages_code.*']
    }))
  ]);

  // 2. Übersetzungen anwenden
  const localizedCategories = rawCategories.map((c: any) => getTranslation(c, lang));
  const localizedArticles = rawArticles.map((a: any) => getTranslation(a, lang));

  currentCategory = localizedCategories.find((cat: any) => String(cat.slug).trim() === category);

  if (currentCategory) {
    currentArticle = localizedArticles.find((art: any) => {
      const artCatId = extractCatId(art.category);
      return String(art.slug).trim() === slug && artCatId === String(currentCategory.id);
    });
  }

  // Fallback: Artikel rein über den Slug finden
  if (!currentArticle) {
    currentArticle = localizedArticles.find((art: any) => String(art.slug).trim() === slug);
  }

  // Sidebar-Tree aufbauen
  categories = localizedCategories.map((cat: any) => ({
    ...cat,
    articles: localizedArticles.filter((art: any) => extractCatId(art.category) === String(cat.id))
  }));

} catch (error) {
  console.error("Directus Wiki i18n Error:", error);
}

if (!currentArticle) {
  return Astro.rewrite('/404');
}
---

<BaseLayout
  title={`${currentArticle.title} | Wiki`}
  description={currentArticle.description || `${currentArticle.title} Dokumentation.`}
  lang={lang}
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col lg:flex-row gap-12">

      <!-- Linke Sidebar -->
      <aside class="w-full lg:w-64 shrink-0">
        <div class="sticky top-24 space-y-8">
          {categories.map((cat: any) => {
            if (!cat.articles || cat.articles.length === 0) return null;

            return (
              <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
                  {cat.title}
                </h3>
                <ul class="space-y-1 border-l border-slate-800 ml-1">
                  {cat.articles.map((art: any) => {
                    const isActive = art.slug === slug && cat.slug === category;
                    return (
                      <li>
                        <a
                          href={`/${lang}/wiki/${cat.slug}/${art.slug}`}
                          class={`block pl-4 py-1.5 text-sm transition-colors -ml-px border-l-2 ${
                            isActive
                              ? 'border-emerald-500 text-emerald-400 font-semibold'
                              : 'border-transparent text-slate-400 hover:text-slate-200 hover:border-slate-700'
                          }`}
                        >
                          {art.title}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            );
          })}
        </div>
      </aside>

      <!-- Rechter Content-Bereich -->
      <main class="min-w-0 flex-1 max-w-4xl">
        <article class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-6 sm:p-10 backdrop-blur-sm">
          
          <header class="mb-8 pb-6 border-b border-slate-800">
            <!-- Obere Zeile: Kategorie links + Sprachwechsler rechts -->
            <div class="flex items-center justify-between gap-4">
              <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider">
                {currentCategory?.title || 'Wiki'}
              </span>

              <!-- Sprachwechsler als kompakte Pill-Buttons -->
              <div class="flex items-center bg-slate-950/80 border border-slate-800 rounded-lg p-1 gap-1">
                <a 
                  href={`/de/wiki/${category}/${slug}`} 
                  class={`px-2.5 py-1 rounded text-xs font-medium transition-all ${
                    lang === 'de' 
                      ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 shadow-sm' 
                      : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50'
                  }`}
                >
                  DE
                </a>
                <a 
                  href={`/en/wiki/${category}/${slug}`} 
                  class={`px-2.5 py-1 rounded text-xs font-medium transition-all ${
                    lang === 'en' 
                      ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 shadow-sm' 
                      : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50'
                  }`}
                >
                  EN
                </a>
              </div>
            </div>

            <!-- Titel & Beschreibung -->
            <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-3 mb-3">
              {currentArticle.title}
            </h1>
            {currentArticle.description && (
              <p class="text-slate-400 text-base">
                {currentArticle.description}
              </p>
            )}
          </header>

          <!-- Artikel Content -->
          <div class="prose prose-invert max-w-none">
            <Fragment set:html={currentArticle.content} />
          </div>
        </article>
      </main>
    </div>
  </div>
</BaseLayout>