---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChangelogList from '../../components/ChangelogList.astro';
import { CHANGELOG_PAGE_SIZE, fetchReleases } from '../../lib/changelog';
import { resolvePath } from '../../utils/navigation';
import { useTranslations } from '../../i18n';

const { lang: rawLang } = Astro.params;
const lang = (rawLang || 'de').toLowerCase();
const t = useTranslations(lang);

// Einen mehr laden, um zu wissen, ob es ältere Releases fürs Archiv gibt
const loaded = await fetchReleases(lang, CHANGELOG_PAGE_SIZE + 1);
const releases = loaded.slice(0, CHANGELOG_PAGE_SIZE);
const hasArchive = loaded.length > CHANGELOG_PAGE_SIZE;
---

<BaseLayout title={t.changelog.pageTitle} description="Alle Updates und Release Notes für Nexus.">
  <div class="py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">

      <!-- Header -->
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
          {t.changelog.pageTitle}
        </h1>
        <p class="text-slate-600 dark:text-slate-400 text-lg">
          {t.changelog.subtitle}
        </p>
      </div>

      {releases.length === 0 ? (
        <div class="text-center py-12 text-slate-500 dark:text-slate-400 bg-slate-900/40 border border-slate-800 rounded-2xl">
          {t.changelog.emptyState}
        </div>
      ) : (
        <ChangelogList releases={releases} lang={lang} openFirst />
      )}

      {hasArchive && (
        <div class="text-center mt-12">
          <a
            href={resolvePath(`/${lang}/changelog/archive/`)}
            class="inline-flex items-center gap-2 text-sm font-semibold px-5 py-2.5 rounded-xl border border-slate-700 text-slate-300 hover:text-white hover:border-slate-500 transition-colors"
          >
            {t.changelog.archiveLink}
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
        </div>
      )}

    </div>
  </div>
</BaseLayout>
