---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL } from '../config';
import { resolvePath } from '../utils/navigation';
import { SUPPORTED_LANGS, DEFAULT_LANG } from '../i18n/config';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  modifiedDate?: Date;
  author?: string;
  lang?: string;
  canonical?: string;
  hreflangUrls?: {
    de?: string;
    en?: string;
    [key: string]: string | undefined;
  };
  appendSiteTitle?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = '/og-image.png',
  type = 'website',
  publishedDate,
  modifiedDate,
  author,
  lang: propLang,
  canonical: propCanonical,
  hreflangUrls,
  appendSiteTitle = true,
} = Astro.props;

const siteURL = SITE_URL.endsWith('/') ? SITE_URL : `${SITE_URL}/`;
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

const detectedLang = (Astro.locals.lang as string) || DEFAULT_LANG;
const currentLang = propLang || detectedLang;

const canonicalURL = propCanonical || new URL(canonicalPath, siteURL).href;
const imageURL = new URL(image, siteURL).href;
const fullTitle = appendSiteTitle ? `${title} | ${SITE_TITLE}` : title;
const robotsContent = 'index, follow';

let resolvedHreflangs = hreflangUrls;

if (!resolvedHreflangs) {
  const segments = Astro.url.pathname.split('/').filter(Boolean);
  if ((SUPPORTED_LANGS as readonly string[]).includes(segments[0])) {
    const rest = segments.slice(1).join('/');
    const subPath = rest ? `/${rest}/` : '/';
    resolvedHreflangs = {
      de: new URL(`/de${subPath}`, siteURL).href,
      en: new URL(`/en${subPath}`, siteURL).href,
    };
  }
}

const structuredData =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: imageURL,
        url: canonicalURL,
        datePublished: publishedDate?.toISOString(),
        dateModified: (modifiedDate ?? publishedDate)?.toISOString(),
        author: author
          ? {
              '@type': 'Person',
              name: author,
            }
          : undefined,
        publisher: {
          '@type': 'Organization',
          name: SITE_TITLE,
          logo: {
            '@type': 'ImageObject',
            url: new URL('/favicon.svg', siteURL).href,
          },
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_TITLE,
        description,
        url: siteURL,
      };

const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '';

const softwareApplicationData = isHomepage
  ? {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: SITE_TITLE,
      applicationCategory: 'CommunicationApplication',
      operatingSystem: 'Discord',
      description: SITE_DESCRIPTION,
      url: siteURL,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        category: 'Free',
      },
    }
  : null;
---

<!DOCTYPE html>
<html lang={currentLang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={resolvePath('/favicon.svg')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={resolvePath('/sitemap.xml')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />

    <!-- Hreflang Tags für Mehrsprachigkeit & SEO -->
    {resolvedHreflangs && (
      <>
        {resolvedHreflangs.de && <link rel="alternate" hreflang="de" href={resolvedHreflangs.de} />}
        {resolvedHreflangs.en && <link rel="alternate" hreflang="en" href={resolvedHreflangs.en} />}
        {(resolvedHreflangs.en || resolvedHreflangs.de) && (
          <link rel="alternate" hreflang="x-default" href={resolvedHreflangs.en || resolvedHreflangs.de} />
        )}
      </>
    )}
    
    <!-- Discord Theme Color: Verpasst dem Discord-Embed einen Mintgrün-Glow -->
    <meta name="theme-color" content="#00F5D4" />
    
    <!-- Open Graph / Discord Previews -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content={currentLang === 'en' ? 'en_US' : 'de_DE'} />
    {type === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate.toISOString()} />
    )}
    {type === 'article' && (modifiedDate ?? publishedDate) && (
      <meta property="article:modified_time" content={(modifiedDate ?? publishedDate)?.toISOString()} />
    )}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {softwareApplicationData && (
      <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationData)} />
    )}
    
    <title>{fullTitle}</title>

    <ClientRouter />
    <!-- Matomo -->
    <script>
    var _paq = window._paq = window._paq || [];
    /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
    _paq.push(["setDoNotTrack", true]);
    _paq.push(["disableCookies"]);
    _paq.push(['trackPageView']);
    _paq.push(['enableLinkTracking']);
    (function() {
        var u="https://matomo.trynexus.de/";
        _paq.push(['setTrackerUrl', u+'matomo.php']);
        _paq.push(['setSiteId', '2']);
        var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
        g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
    })();
    </script>
    <!-- End Matomo Code -->

  </head>
  <body class="flex flex-col min-h-screen bg-[#09090b] text-slate-100 antialiased selection:bg-primary-500/30 selection:text-primary-300">
    <CommandPalette />
    <Navbar lang={currentLang} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer lang={currentLang} />

    <!-- Global Intersection Observer for Scroll Animations -->
    <script>
      document.addEventListener('astro:page-load', () => {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
            }
          });
        }, {
          root: null,
          rootMargin: '0px',
          threshold: 0.1
        });

        document.querySelectorAll('.reveal-on-scroll').forEach((el) => {
          observer.observe(el);
        });
      });
    </script>
  </body>
</html>